FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    atmosphere { 
            type pressureInletOutletVelocity;
            phi phi;
            rho rho; 
            tangentialVelocity uniform (0 0 0); 
            value uniform (0 0 0); 
        }

    frontAndBack
    {
        type            empty;
    }

    rightWall
    {
       type slip; 
    }

    leftWall
    {
       type slip; 
    }

    lowerWall
    {
       type   slip;
    }
}

// ************************************************************************* //
