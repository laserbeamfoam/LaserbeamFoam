FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      xi;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    atmosphere
    {
         type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }

    rightWall
    {
        type            zeroGradient;
    }

    leftWall
    {
        type            zeroGradient;
    }

    lowerWall
    {
        type            zeroGradient;
    }
}

