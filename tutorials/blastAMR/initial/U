FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Solid substrate - wall
    bottom
    {
        type            noSlip;
    }

    // Open boundaries - let flow escape freely
    top
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    back
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    front
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    left
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    right
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
}

