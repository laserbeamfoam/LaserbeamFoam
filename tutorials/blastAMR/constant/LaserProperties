FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      PhaseFieldProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

timeVsLaserPosition
{
    file    "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file    "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

V_incident	(0 1 0);//(0 1 0);//NORMALISED IN CODE

laserRadius 0.00005;

wavelength	1.064e-6;
e_num_density	5.83e29;
//elec_resistivity	1.0e-6;

profiles
{
    core
    {
        type    gaussian;

        // Match the legacy Radius_Flavour = 2 Gaussian:
        // exp(-2*(r/laserRadius)^2) = exp(-(r/profileRadius)^2)
        radius  3.5355339059e-5;

        sampling
        {
            type     radialPolar;
            radius   7.5e-5;
            nRadial  60;
            nAngular 180;
        }
    }
}

Radius_Flavour	2.0;

useLocalSearch    true;//false;

//N_sub_divisions    6;
