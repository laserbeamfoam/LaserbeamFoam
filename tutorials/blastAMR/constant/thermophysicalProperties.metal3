FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.Nickel;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseState      condensed;  // or: gaseous, solid

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState adiabaticPerfectFluid; //adiabaticPerfectFluid;//perfectFluid;
    specie          specie;
    energy          sensibleInternalEnergy;
}

// 316L alloy-specific phase change (Keep identical in all metal files)
TSolidus                1648.0;   // Solidus [K]
TLiquidus               1673.0;   // Liquidus [K]
LatentHeat              2.9e5;    // [J/kg]

// Electromagnetic properties (MHD)
elec_conductivity       7e5;   // [S/m]
magnetic_permeability   1.257e-6; // [H/m]

mixture
{
    specie
    {
        molWeight   58.69;
    }
    equationOfState
    {
       p0		1e5;
       rho0     8900;
       gamma	1.1;
       B		1.8e11; //CHECK THIS - Q deposited = 0 if increased above 1e9 Should be 1.8e11
	  // rho 8900;
    }
    thermodynamics
    {
        Cp          444;
        Hf          0;
    }
    transport
    {
        mu          5.0e-3;
        Pr          0.02;
    }
}


// ************************************************************************* //
