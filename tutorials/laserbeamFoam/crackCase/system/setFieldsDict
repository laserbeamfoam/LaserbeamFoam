FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.metal 0 // Default the whole world to Air
);

regions
(
    zoneToCell
    {
        name            metalZone;   // This must match snappyHexMeshDict
        fieldValues
        (
            volScalarFieldValue alpha.metal 1 // Set the substrate to Metal
        );
    }
);