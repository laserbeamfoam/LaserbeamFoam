FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      kinematicCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          true;
    coupled         true;
    transient       yes;
    cellValueSourceCorrection off;
    
    writeActiveOnly true;  //

    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        mu              cell;
        DUcDt               cellPoint;
        nonOrthDeltaCoeffs  cell;
    }

    integrationSchemes
    {
        U               Euler;
    }

    sourceTerms
    {
        schemes
        {
            U semiImplicit 1;
        }
    }
}

constantProperties
{
    rho0            16650;
    
    // Thermal properties
    Tmelt      3290;   // Melting point [K] (3017°C)
    boilingTemperature      5731;   // Boiling point [K] (5458°C)
    CpParticle    140;    // Average Cp [J/kg/K]
    LfParticle      174000; // Latent heat of melting [J/kg]
    thermalConductivity     57.5;   // [W/m/K]
    
    // Modeling parameters
    MeltingTimescale        0.005;   // Characteristic melting time [s] - tunable
    Tinject    300;    // Powder feed temperature [K] (room temp)
    
    
}

subModels
{
    particleForces
    {
        
        gravity;
        
                sphereDrag
        {
            // Can specify drag model here if needed
            // Default is Schiller-Naumann, good for these Reynolds numbers
        }
        

    
    }
