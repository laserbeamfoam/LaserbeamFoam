            //         sigma       10e-6;   // Standard deviation
            //     }
            // }
            
            
            
            
            
    }
}
  
  
  
        

    dispersionModel none;
    
    patchInteractionModel standardWallInteraction;
    
    stochasticCollisionModel none;
    
    standardWallInteractionCoeffs
    {
        type rebound;  // Particles bounce off walls
        
        // Restitution coefficients (energy loss on impact)
        e   0.5;  // Normal restitution (0-1, 1 = perfectly elastic)
        mu  0.3;  // Tangential restitution/friction
    }

    surfaceFilmModel none;
}

