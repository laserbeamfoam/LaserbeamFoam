injectionModels
{
    tantalumPowderFeed
    {
        type            coneInjection;
        
        // Jet origin and orientation
       // position        (0 0.01 0);
                // List of (position, axis) pairs - note the double parentheses
      
        positionAxis
        (
            ((0 0.001 0) (0 1 0))  // (position vector) (axis vector)
        );

        
       // direction       (0 1 0);
        
        // Cone geometry
        thetaInner      0;
        thetaOuter      8;
        
        // Time control
        duration        1;
        SOI             0;
        
        // Flow rate
        massTotal       1e-2;
        nParticle	1;
        parcelBasisType fixed;//mass;
        
        parcelsPerInjector 5000000;    // Required: parcels per injector
        
        // Use table format for flowRateProfile
        flowRateProfile table
        (
            (0  500000)
            (10 500000)
        );
        
        parcelsPerSecond 50000;
        
        // Use table format for Umag
        Umag table
        (
            (0  1)
            (10 1)
        );
        
        // Particle size
            sizeDistribution
            {
                type        RosinRammler;
                RosinRammlerDistribution
                {
                    minValue    60e-6;   // 15 microns (minimum)
                    maxValue    100e-6;   // 63 microns (maximum)
                    lambda      75e-6;   // Mean diameter: 45 microns (typical for Ta powder)
                    n           3.5;     // Distribution parameter (3-4 is typical)
                }
            }
            
            
            
                        // Alternative: Normal distribution
