FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      kinematicCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          true;
    coupled         true;
    transient       yes;
    cellValueSourceCorrection off;
    
    writeActiveOnly true;  //

    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        mu              cell;
        DUcDt               cellPoint;
        nonOrthDeltaCoeffs  cell;
    }

    integrationSchemes
    {
        U               Euler;
    }

    sourceTerms
    {
        schemes
        {
            U semiImplicit 1;
        }
    }
}

constantProperties
{
    rho0            16700;
}

subModels
{
    particleForces
    {
        sphereDrag;
        gravity;
    }
