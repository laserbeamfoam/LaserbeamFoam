FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      PhaseFieldProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

timeVsLaserPosition
{
    file    "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file    "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

radialPolarHeatSource yes;

V_incident	(0 1 0.5);//(0 1 0);//NORMALISED IN CODE

laserRadius 0.0005;

profiles
{
    core
    {
        type        superGaussian;
        radius      0.0003;
        order       2.0;
        weight      0.7;
    }

    ring
    {
        type        annular;
        innerRadius 0.0002;
        outerRadius 0.0005;
        falloff     0.00003;
        weight      0.3;
    }
}


nRadial	50;
nAngular	180;


wavelength	1.064e-6;
e_num_density	5.83e29;
//elec_resistivity	1.0e-6;


Radius_Flavour	2.0;

useLocalSearch    true;//false;

//N_sub_divisions    6;
