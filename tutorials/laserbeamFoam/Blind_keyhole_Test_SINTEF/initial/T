		type 	zeroGradient;
    }

	frontAndBack
	{
		type 	zeroGradient;
		/*
		type fixedGradient;
		gradient uniform -50.0;		
		*/
	}

    leftWall
    {
		type 	zeroGradient;
		/*
		type fixedGradient;
		gradient uniform -50.0;		
		*/
    }
    
    rightWall
    {
		type 	zeroGradient;
		/*
		type fixedGradient;
		gradient uniform -50.0;		
		*/
    }

}

