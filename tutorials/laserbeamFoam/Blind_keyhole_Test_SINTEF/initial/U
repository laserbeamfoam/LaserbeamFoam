		value 				uniform (0 0 0.5);
		
		//type 			pressureInletOutletVelocity;
		//value 			uniform (0 0 0);
    }
    
    lowerWall
    {
		//type 			pressureInletOutletVelocity;
		//value 			uniform (0 0 0);
	    type            noSlip;
	    //type            zeroGradient;	    		
    }    
    
	frontAndBack
	{
	    //type            zeroGradient;
	    type            slip;
	}
    
    leftWall
    {
        //type            zeroGradient;
		type            slip;
    }
    
    rightWall
    {
        //type            zeroGradient;
		type            slip;
    }


}


