startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.0007;

deltaT          1e-06;

writeControl    timeStep;

writeInterval   100;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

