FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.0;

boundaryField
{
    back
    {
      type		zeroGradient;
    }
    front
    {
      type		zeroGradient;

    }
    leftWall
    {
      type		zeroGradient;

    }
    rightWall
    {
      type		zeroGradient;

    }
    topWall
    {
      type zeroGradient;
    }
    bottomWall
    {
      type		zeroGradient;

    }
    defaultFaces
    {
      type		zeroGradient;

    }

}



