FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Laser_boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    back
    {
      type fixedValue;
value uniform -1.0;
    }
    front
    {
      type fixedValue;
      value uniform -1.0;
    }
    leftWall
    {
      type fixedValue;
value uniform -1.0;
    }
    rightWall
    {
      type fixedValue;
value uniform -1.0;
    }
    topWall
    {
      type fixedValue;
value uniform 1.0;
    }
    bottomWall
    {
      type fixedValue;
      value uniform -1.0;
    }
    defaultFaces
    {
        type            empty;
    }
}

