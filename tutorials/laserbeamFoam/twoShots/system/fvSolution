FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.metal.*"
    {
        isoFaceTol      1e-6;
        surfCellTol     1e-6;
        nAlphaBounds    3;
        snapTol         1e-12;
        clip            true;
        reconstructionScheme isoAlpha;
        writeFields     true;

        nAlphaSubCycles 1;
        cAlpha          1;

        // Previous MULES settings kept for traceability:
        //
        // nAlphaCorr      2;
        // nAlphaSubCycles 1;
        //
        // cAlpha          1;
        //
        // MULESCorr       yes;
        // nLimiterIter    5;
        //
        // solver          smoothSolver;
        // smoother        symGaussSeidel;
        // tolerance       1e-8;
        // relTol          0;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    }

    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-07;
        relTol          0.05;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0;
    }
        T
    {
/*
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-12;
        minIter         1;
        maxIter         500;//2
*/
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-9;
        relTol          0.0;
    }

    TFinal
    {
        $T;
    }
}

MELTING
{
    minTempCorrector 1;
    maxTempCorrector 20;
    epsilonTolerance 1e-6;
    epsilonRelaxation 0.9;
    
    damperSwitch true;//false;//true;
}

isoAdvector
{
    CrankNicolsonCoeff 0.5;
    gradAlphaNormal true;

    alphaFluxTolerance 1e-6;
    vof2IsoTol         1e-6;

    clipAlphaTol 1e-6;
    nAlphaBounds 1;
    snapAlpha   false;
}

PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    1;
    nCorrectors         3;
    nNonOrthogonalCorrectors 0;
}

relaxationFactors
{
    equations
    {
        ".*" 1;
    }
}


