FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.metal 0
);

regions
(
    // Ti-6Al-4V plate, 100 um thick
    boxToCell
    {
        box (0 0 0) (200e-6 100e-6 200e-6);
        fieldValues
        (
            volScalarFieldValue alpha.metal 1
        );
    }
);

