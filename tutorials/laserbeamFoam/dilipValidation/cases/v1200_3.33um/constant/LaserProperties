FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      PhaseFieldProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

radialPolarHeatSource no;

timeVsLaserPosition
{
    file    "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file    "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

// Laser angle (normalised in the code)
V_incident (0 -1 0);

// LPBF_large steel tutorial value: laserRadius 25e-6
// laserMeltFoam_Reference_Case laser value: laserRadius 37.5e-6
laserRadius 5e-05;

N_sub_divisions	1;

// laserMeltFoam_Reference_Case laser value: wavelength 1.064e-6
wavelength	1.064e-6;
// LPBF_large steel tutorial value: e_num_density 5.83e29
// Ti6Al4V value from LaserbeamFoam/cunninghamValidation: e_num_density 1.11e30
e_num_density	1.11e30;
Radius_Flavour	2.0;
PowderSim true;

// Thermal mode of laserbeamFoam for long laser pauses (pull request #151,
// https://github.com/laserbeamfoam/LaserbeamFoam/pull/151);
// initialDeltaT is the maxDeltaT of the full mode.
longPause
{
    // Entry: all lasers off, none turned on for at least minPause [s]
    minPause            70e-6;

    // Entry: largest liquid fraction allowed in metal cells
    maxLiquidFraction   1e-6;

    // Entry: metal below the solidus by at least this margin [K]
    solidusMargin        20;

    // Entry: largest metal velocity [m/s]
    maxMetalVelocity    1e-3;

    // Exit: this long before the next laser is turned on [s]
    leadTime            5e-6;

    // Time step: first value [s], largest value [s], largest temperature
    // change per step [K] and largest growth factor between steps
    initialDeltaT       1e-8;
    maxDeltaT           1e-5;
    maxTemperatureChange 5;
    maxDeltaTGrowth     1.2;
}

