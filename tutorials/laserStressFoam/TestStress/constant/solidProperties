FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidElasticity
{
    coupling        implicit;

    maxIter         3;
    tolerance       1e-5;
    relTol          0.2;
    compactNormalStress true;

    E               2.0e11;
    nu              0.30;
    alphaT          1.2e-5;
    Tref            300;

    solidDamping    1.0e12;
    fSolidMin       1e-6;
}

