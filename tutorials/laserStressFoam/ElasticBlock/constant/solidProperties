FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidElasticity
{
    enabled             true;
    coupling            implicit;

    maxIter             12;
    tolerance           1e-8;
    relTol              0.0;
    compactNormalStress true;

    E                   2.0e11;
    nu                  0.30;
    alphaT              1.2e-5;
    Tref                300;

    solidDamping        1.0e-6;
    fSolidMin           1e-6;
}

