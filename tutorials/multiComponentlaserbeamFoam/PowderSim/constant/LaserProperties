FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      PhaseFieldProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
timeVsLaserPosition
{
    file    "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserIncidentVector
{
    file    "$FOAM_CASE/constant/timeVsLaserIncidentVector";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file    "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

N_sub_divisions	2;

HS_a 10e-5;


wavelength	1.064e-6;

e_num_density	1e29;


// Use local search: defaults to yes
//useLocalSearch yes;

// Print extra debug information: defaults to no
debug no;

PowderSim true;
