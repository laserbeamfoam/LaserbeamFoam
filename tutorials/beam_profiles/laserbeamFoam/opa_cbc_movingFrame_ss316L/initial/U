FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 -0.166667);

boundaryField
{
    zMin
    {
        type            pressureInletOutletVelocity;
        phi             phi;
        rho             rho;
        tangentialVelocity uniform (0 0 -0.166667);
        value           uniform (0 0 -0.166667);
    }

    zMax
    {
        type            pressureInletOutletVelocity;
        phi             phi;
        rho             rho;
        tangentialVelocity uniform (0 0 -0.166667);
        value           uniform (0 0 -0.166667);
    }

    lowerWall
    {
        type            pressureInletOutletVelocity;
        phi             phi;
        rho             rho;
        tangentialVelocity uniform (0 0 -0.166667);
        value           uniform (0 0 -0.166667);
    }

    atmosphere
    {
        type            pressureInletOutletVelocity;
        phi             phi;
        rho             rho;
        tangentialVelocity uniform (0 0 -0.166667);
        value           uniform (0 0 -0.166667);
    }

    rightWall
    {
        type            pressureInletOutletVelocity;
        phi             phi;
        rho             rho;
        tangentialVelocity uniform (0 0 -0.166667);
        value           uniform (0 0 -0.166667);
    }

    leftWall
    {
        type            pressureInletOutletVelocity;
        phi             phi;
        rho             rho;
        tangentialVelocity uniform (0 0 -0.166667);
        value           uniform (0 0 -0.166667);
    }

    defaultFaces
    {
        type            empty;
    }
}


