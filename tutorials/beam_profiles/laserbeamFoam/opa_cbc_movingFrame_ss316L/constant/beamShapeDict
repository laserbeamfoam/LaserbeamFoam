FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      shapeNamesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

shapeNames
(
    "circle"
);

shapeFrequency    (100e3);       // Hz, must be same length as shapeNames
shapeDuration     (1e-5);        // s, must be same length as shapeNames - must be equal to nAddresses/shapeFrequency for a single shape

circle
(
    (   5   3  )
    (   3   5  )
    (   0   6  )
    (  -3   5  )
    (  -5   3  )
    (  -6   0  )
    (  -5  -3  )
    (  -3  -5  )
    (   0  -6  )
    (   3  -5  )
    (   5  -3  )
    (   6   0  )
    (   0   3  )
    (  -3   0  )
    (   0  -3  )
    (   3   0  )
    (   0   0  )
);

