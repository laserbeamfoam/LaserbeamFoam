FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh   dynamicRefineFvMesh;

// Update refinement every time step for this short diagnostic case.
refineInterval  1;

// Solver-side refineFlag excludes rayQ so refinement tracks the melt/interface.
field           refineFlag;
lowerRefineLevel 0.5;
upperRefineLevel 1.5;

// Keep refined beam cells instead of oscillating between levels.
unrefineLevel   0.0001;

nBufferLayers   2;

// One level beyond the other beam-profile gallery cases.
maxRefinement   5;

maxCells        2E+7;

correctFluxes
(
    (phi U)
    (nHatf none)
    (rhoPhi none)
    (alphaPhi0.metal none)
    (ghf none)
    (alphaPhiUn none)
    (rhophicp none)
    (dVf_ none)
    (alphaPhi_ none)
);

dumpLevel       true;


