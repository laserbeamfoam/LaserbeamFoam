FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      LaserProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Five super-Gaussian beams laid out from -x to +x.
// The total power is intentionally kept constant so the progression shows
// how the beam shape changes as the order increases from Gaussian-like
// to top-hat-like.

lasers
(
    laser0
    {
        timeVsLaserPosition
        {
            file    "$FOAM_CASE/constant/timeVsLaserPosition0";
            outOfBounds clamp;
        }

        timeVsLaserPower
        {
            file    "$FOAM_CASE/constant/timeVsLaserPower0";
            outOfBounds clamp;
        }

        V_incident      (0 1 0);
        laserRadius     160e-6;
        wavelength      1.064e-6;
        e_num_density   5.83e29;

        profiles
        {
            gaussianLike
            {
                type        superGaussian;
                radius      160e-6;
                order       2.0;
                cutoff      1e-6;

                sampling
                {
                    type     radialPolar;
                    radius   5.95e-4;
                    nRadial  80;
                    nAngular 160;
                }
            }
        }

        useLocalSearch   true;
        Radius_Flavour   2.0;
    }

