FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      LaserProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Single laser with Cailabs ring-core CSV beam profile
// 10mm straight weld at constant velocity
// Experimental beam profile from FocusMonitor data (496x379 grid, 2.55µm x 3.325µm spacing)

lasers
(
    laser0
    {
        timeVsLaserPosition
        {
            file    "$FOAM_CASE/constant/timeVsLaserPosition0";
            outOfBounds clamp;
        }

        timeVsLaserPower
        {
            file    "$FOAM_CASE/constant/timeVsLaserPower0";
            outOfBounds clamp;
        }
        
        // Laser beam parameters
        V_incident                      (0 1 0);
        laserRadius                     0.0005;    // Ray tracing region radius (m) - 0.5mm
        wavelength                      1030e-9;   // Wavelength (m) - typical fiber laser
        e_num_density                   10;        // Number density for ray tracing
        
        // Beam profile: CSV from FocusMonitor experimental data
        profiles
        {
            ringCore
            {
                type        csv;
                file        "$FOAM_CASE/constant/intensity_smallRingHomo.csv";
                nx          496;
                nz          379;
                dx          2.550000e-06;
                dy          3.325000e-06;

                sampling
                {
                    type        cartesian;
                    halfWidthX  6.31125e-4;
                    halfWidthZ  6.28425e-4;
                    nCartesianX 496;
                    nCartesianZ 379;
                }
            }
        }
        
        // Ray tracing settings
        useLocalSearch                  false;
        Radius_Flavour                  1;
    }
);
