        profiles
        {
            stepwiseMultimode
            {
                type        superGaussian;
                radius      170e-6;
                order       2.0;
                cutoff      1e-6;

                sampling
                {
                    type     radialPolar;
                    radius   6.32e-4;
                    nRadial  72;
                    nAngular 144;
                }

                modifiers
                {
                    noise
                    {
                        type            drumNoise;
                        radius          170e-6;
                        evolution       stepwise;
                        randomPhase     true;
                        randomAmplitude true;
                        amplitudeJitter 0.18;
                        seed            12345;
                        minFactor       0.05;

                        modes
                        {
                            core
                            {
                                azimuthalOrder  0;
                                radialOrder     1;
                                amplitude       0.12;
                            }

                            pair
                            {
                                azimuthalOrder  2;
                                radialOrder     1;
                                amplitude       0.10;
                                phase           20;
                            }

                            clover
                            {
                                azimuthalOrder  4;
                                radialOrder     1;
                                amplitude       0.08;
                                phase           45;
                            }
                        }
                    }
                }
            }
        }

        useLocalSearch   true;
        Radius_Flavour   2.0;
    }
);
