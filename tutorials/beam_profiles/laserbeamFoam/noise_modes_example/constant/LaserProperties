                }

                modifiers
                {
                    noise
                    {
                        type        drumNoise;
                        radius      170e-6;
                        evolution   continuous;
                        minFactor   0.05;

                        modes
                        {
                            core
                            {
                                azimuthalOrder  0;
                                radialOrder     1;
                                amplitude       0.12;
                                frequency       1.2e6;
                                phase           0;
                            }

                            pair
                            {
                                azimuthalOrder  2;
                                radialOrder     1;
                                amplitude       0.11;
                                frequency       2.4e6;
                                phase           35;
                            }

                            swirl
                            {
                                azimuthalOrder  3;
                                radialOrder     1;
                                amplitude       0.08;
                                frequency       3.6e6;
                                phase           90;
                            }
                        }
                    }
