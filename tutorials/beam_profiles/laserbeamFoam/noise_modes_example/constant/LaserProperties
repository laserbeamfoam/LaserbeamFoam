            outOfBounds clamp;
        }

        V_incident      (0 1 0);
        laserRadius     170e-6;
        wavelength      1.064e-6;
        e_num_density   5.83e29;

        profiles
        {
            azimuthalMode
            {
                type        superGaussian;
                radius      170e-6;
                order       2.0;
                cutoff      1e-6;

                sampling
                {
                    type     radialPolar;
                    radius   6.32e-4;
                    nRadial  72;
                    nAngular 144;
                }

                modifiers
                {
                    noise
                    {
                        type        drumNoise;
                        radius      170e-6;
                        evolution   continuous;
                        minFactor   0.05;

                        modes
                        {
                            lobed
                            {
                                azimuthalOrder  2;
                                radialOrder     1;
                                amplitude       0.22;
                                frequency       2.1e6;
                                phase           30;
                            }
                        }
                    }
                }
            }
        }

        useLocalSearch   true;
        Radius_Flavour   2.0;
    }

    laser3
    {
        timeVsLaserPosition
        {
            file    "$FOAM_CASE/constant/timeVsLaserPosition3";
            outOfBounds clamp;
        }

        timeVsLaserPower
        {
