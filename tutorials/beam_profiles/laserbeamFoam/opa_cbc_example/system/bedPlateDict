FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      bedPlateDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Bed true;
verticalAxis "-y";

xmin -1e-3;
xmax  1e-3;

ymin  1.5e-4;
ymax  2.5e-4;

zmin -1e-3;
zmax  5e-3;

