FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 -0.5);

boundaryField
{

//    #includeEtc "caseDicts/setConstraintTypes"
    
    
	frontAndBack{
        type                pressureInletOutletVelocity;
        phi                 phi;
        rho                 rho;
        tangentialVelocity  uniform (0 0 -0.5);
        value               uniform (0 0 -0.5);
	}
    lowerWall
    {
        type                pressureInletOutletVelocity;
        phi                 phi;
        rho                 rho;
        tangentialVelocity  uniform (0 0 -0.5);
        value               uniform (0 0 -0.5);
    }
    atmosphere
    {
        type                pressureInletOutletVelocity;
        phi                 phi;
        rho                 rho;
        tangentialVelocity  uniform (0 0 -0.5);
        value               uniform (0 0 -0.5);
    }
    rightWall
    {
        type                pressureInletOutletVelocity;
        phi                 phi;
        rho                 rho;
        tangentialVelocity  uniform (0 0 -0.5);
        value               uniform (0 0 -0.5);
    }
    leftWall
    {
        type                pressureInletOutletVelocity;
        phi                 phi;
        rho                 rho;
        tangentialVelocity  uniform (0 0 -0.5);
        value               uniform (0 0 -0.5);
    }
    defaultFaces
    {
        type            empty;
    }
}


