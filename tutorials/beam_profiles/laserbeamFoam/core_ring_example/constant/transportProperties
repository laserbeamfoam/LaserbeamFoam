FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Interface tracking method: isoAdvector or MULES
interfaceTrackingScheme MULES;

phases          (metal gas);

metal
{
    transportModel      Newtonian;
    nu                  2.4E-7;

    rho                 2500;

    Tsolidus            723.6355;
    Tliquidus           916.97432;
    LatentHeat          3.97e5;
    beta                5.0e-6;
    poly_kappa          (237 0.0 0 0 0 0 0 0);
    poly_cp             (900 0.0 0 0 0 0 0 0);
    elec_resistivity	5.0e-7;
}

gas
{
    transportModel      Newtonian;

    nu                  1.48e-05;

    rho                 1;

    poly_kappa          (0.04 0 0 0 0 0 0 0);
    poly_cp             (520 0 0 0 0 0 0 0);

    Tsolidus            1.0;
    Tliquidus           10.0;
    LatentHeat          1;
    beta                4.0e-5;
}

sigma                   0.84;
Marangoni_Constant	    -5e-4;
p0	                    1e5;
Tvap	                2700;
Mm	                    0.026981539;
LatentHeatVap           11e+6;
emS                     0.4;
emL                     0.1;
TRef                    TRef [0 0 0 1 0 0 0] 300;

// ************************************************************************* //