            file    "$FOAM_CASE/constant/timeVsLaserPower0";
            outOfBounds clamp;
        }

        V_incident      (0 1 0);
        laserRadius     1.2e-3;
        wavelength      1.064e-6;
        e_num_density   5.0e29;

        profiles
        {
            core
            {
                type        superGaussian;
                radius      0.55e-3;
                order       6.0;
                cutoff      1e-5;
                weight      1.0;

                sampling
                {
                    type     radialPolar;
                    radius   8.27e-4;
                    nRadial  120;
                    nAngular 240;
                }
            }
            
            ring
            {
                type        annular;
                innerRadius 0.60e-3;
                outerRadius 0.95e-3;
                falloff     0.08e-3;
                weight      0.0;

                sampling
                {
                    type     radialPolar;
                    radius   1.35e-3;
                    nRadial  120;
                    nAngular 240;
                }
            }
        }

        useLocalSearch   true;
        Radius_Flavour   2.0;
    }

