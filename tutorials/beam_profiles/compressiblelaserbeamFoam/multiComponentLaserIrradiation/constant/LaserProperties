FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      LaserProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
timeVsLaserPosition
{
    file    "$FOAM_CASE/constant/timeVsLaserPosition";
    outOfBounds clamp;
}

timeVsLaserPower
{
    file    "$FOAM_CASE/constant/timeVsLaserPower";
    outOfBounds clamp;
}

V_incident	(0 1 0);//(0 1 0);//NORMALISED IN CODE

laserRadius 0.001;

wavelength	1.064e-6;
e_num_density	5.83e29;
//elec_resistivity	1.0e-6;

profiles
{
    core
    {
        type    superGaussian;
        radius  0.00045;
        order   2.0;
        weight  0.15;

        sampling
        {
            type     radialPolar;
            radius   0.00168;
            nRadial  50;
            nAngular 360;
        }
    }

    ring
    {
        type        annular;
        innerRadius 0.00018;
        outerRadius 0.00075;
        falloff     5e-05;
        weight      0.85;

        sampling
        {
            type     radialPolar;
            radius   0.001;
            nRadial  50;
            nAngular 360;
        }
    }
}


Radius_Flavour	2.0;

useLocalSearch    true;//false;

//N_sub_divisions    6;
