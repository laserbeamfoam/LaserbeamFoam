FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// For serious runs, consider using tightened tolerances in trailing comments:
std_tol         1e-6;  // 1e-11;
final_tol       1e-7;  // 1e-12;
mthd_std_tol    1e-10; // 1e-11;
mthd_final_tol  1e-11; // 1e-12;

solvers
{
    "alpha.*"
    {
        nAlphaSubCycles 0; // seems to be causing issues when >0

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;
        relTol          0;

        MULEScorr       yes;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            tolerance       $std_tol;
            relTol          0.05;
            smoother        GaussSeidel;
        }
        tolerance       $std_tol;
        relTol          0;
        maxIter         1000;
    }

    ".*(rho|rhoFinal)"
    {
        solver          diagonal;
    }

    p_rgh
    {
        solver          GAMG;
        tolerance       $std_tol;
        relTol          0.0;
        smoother        GaussSeidel;
    }

    p_rghFinal
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            tolerance       $final_tol;
            relTol          0;
            nVcycles        5;
            smoother        GaussSeidel;
        }
        tolerance       $final_tol;
        relTol          0;
        maxIter         2000;
    }

    "(U|k|B|nuTilda)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       $std_tol; // 1e-012;
        relTol          0.0;
        nSweeps         1;
    }

    "(U|k|B|nuTilda)Final"
    {
        $U;
        tolerance       $final_tol;
        relTol          0;
    }


    // For Richter: case has no to negigble temperature change for 0<=B<=0.505
    // [T]. If the user modifies the magnetic properties, please adjust the T
    // and TFinal settings accordingly.
    T
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-5;
        relTol          0.0;
        nSweeps         1;

        maxIter         25; // <- main bottle neck on standard Richter runs.
    }

    TFinal
    {
        $T;
    }

    // ----------------------------------------------------------------------------- //
    H
    {
        /*
        solver          smoothSolver;
        smoother        GaussSeidel;//GaussSeidel;//DICGaussSeidel;//
        tolerance       1e-09;
        relTol          0.0;//0.1;
        nSweeps         2;//1;
        maxIter         5000;
        */
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       $mthd_std_tol;
        minIter         1;
        maxIter         500;


    }

    HFinal
    {
        $H;
        tolerance       $mthd_final_tol;
        relTol          0;
    }

    pH
    {
        /*
        $p_rgh;
        tolerance       $std_tol;
        relTol          0.0;
        maxIter         5000;
        */
        solver          PCG;
        preconditioner  DIC;
        tolerance       $std_tol;
        relTol          0.0;

    }

    pHFinal
    {
        $pH;
        relTol          0;
    }
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}

MELTING
{
    minTempCorrector 1;
    maxTempCorrector 50;    // 20;
    epsilonTolerance 1e-12; // 1e-9;
    epsilonRelaxation 0.9;
}

PIMPLE
{
    nOuterCorrectors            2; // Only affects (U-p)-H-T
    nCorrectors                 3;
    nNonOrthogonalCorrectors    2; // >0 when AMR used.
}

// MHD Specific
BPISO
{
    nOuterCorrectors            1; // always 1
    nCorrectors                 3;
    nNonOrthogonalCorrectors    2; // >0 when AMR used.
    pRefCell                    0;
    pRefValue                   0.0;
}

