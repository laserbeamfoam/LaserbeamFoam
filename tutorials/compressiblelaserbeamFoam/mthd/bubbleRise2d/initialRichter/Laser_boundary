FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
	// frontAndBack
    // {
    //     type        zeroGradient;
    //     // type fixedValue;
    //     // value uniform 0; // -1.0;
	// }

    lowerWall
    {
        type fixedValue;
        value uniform 0; // -1.0;
    }

    atmosphere
    {
        type fixedValue;
        value uniform 0; // 1.0;
    }

    front
    {
        type zeroGradient;
    }
    back
    {
        type zeroGradient;
    }
    defaultFaces
    {
        type            zeroGradient;
        // type fixedValue;
        // value uniform 0; // -1.0;
    }

    leftWall
    {
        $lowerWall;
    }

    rightWall
    {
        $lowerWall;
    }
}

