FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.air;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseState      gaseous;  // or: liquid, solid

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleInternalEnergy;
}

TSolidus                1.0;
TLiquidus               2.0;
LatentHeat              1.0;
elec_conductivity       1.0;
magnetic_permeability   1.256e-6;

mixture
{
    specie
    {
        molWeight       28.9;
    }
    thermodynamics
    {
        // Commented values are from rhoCentralFoam
        Cp              1004.5;
        Hf              0;    // 2.544e+06;
        /*
        Cv is apparently calculated by
            Cp - Cv = R_universal / W_molar
            => Cv = Cp - 8314.46/28.9
                  = 717.3
        Hence, gamma Cp/Cv would be ~ 1.4.
        */
    }
    transport
    {
        mu              0;
        Pr              1e15; // 0.7;
        /*
            Pr := nu / alpha
                = (mu / rho) * (rho * cp / kappa)
        =>  kappa = mu * cp / Pr
        Therefore for Kappa->0, we let Pr -> infinity.
        */
        kappa           0; // <- is not being read
    }
}


// ************************************************************************* //
