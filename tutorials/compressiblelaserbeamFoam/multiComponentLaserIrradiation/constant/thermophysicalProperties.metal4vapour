FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.metal4vapour;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// metal4vapour = MOLYBDENUM VAPOUR (perfectGas, R derived from molWeight)

phaseState      gaseous;  // or: gaseous, solid

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          eConst;
    equationOfState perfectFluid;//perfectGas;//
    specie          specie;
    energy          sensibleInternalEnergy;
}

TSolidus    5.0;
TLiquidus   10.0;
LatentHeat  1.0;

elec_conductivity   1.0;
magnetic_permeability   1.256e-6;

mixture
{

	equationOfState
{
    R           87;
    rho0        0.0;
}

    specie
    {
        molWeight   95.95;          // Mo -> R = 8314/95.95 ~ 87 J/kg/K
    }
    thermodynamics
    {
        Cv          130;            // monatomic vapour, 1.5*R
        Hf          0;
    }
    transport
    {
        mu          1.0e-5;
        Pr          0.67;
    }
}


// ************************************************************************* //
