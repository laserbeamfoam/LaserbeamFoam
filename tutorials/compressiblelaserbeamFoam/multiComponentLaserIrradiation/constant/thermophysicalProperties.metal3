FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.metal3;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// metal3 = NICKEL (Ni) - ~12 wt% of 316L
// (was rho0 = 600 in the original - that is lighter than water and not a
//  physical metal density; corrected to the liquid Ni value below.)

phaseState      condensed;  // or: gaseous, solid

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState adiabaticPerfectFluid;//rhoConst;//perfectFluid;
    specie          specie;
    energy          sensibleInternalEnergy;
}

TSolidus    1658.0;
TLiquidus   1723.0;
LatentHeat  2.7e5;          // fusion latent heat of 316L
elec_conductivity   1.0e6;
magnetic_permeability   1.256e-6;

mixture
{
    specie
    {
        molWeight   58.69;          // Ni
    }
    equationOfState
    {
        p0      1e5;
        rho0    7810;               // liquid Ni density near melting [kg/m3]
        gamma   1.2;
        B       1e7;                // softened for acoustic CFL; physical ~1.6e11
    }
    thermodynamics
    {
        Cp          800;
        Hf          0;
    }
    transport
    {
        mu          6.0e-3;
        Pr          0.16;
    }
}


// ************************************************************************* //
