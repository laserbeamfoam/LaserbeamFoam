FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    div(rhoPhi,U)  Gauss upwind;
    div(phi,alpha)  Gauss vanLeer; //ROUNDAplus01;
    div(phiR,alphaRho) Gauss vanLeer; //ROUNDAplus01;


    div(phirb,alpha) Gauss linear;
    "div\(phi,.*rho.*\)" Gauss upwind;
    div(rhoPhi,T)  Gauss upwind;
    div(rhoPhi,K)  Gauss upwind;
    div(phi,p)      Gauss upwind;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;

    div(rhoPhi,epsilon1)	Gauss linear;//Gauss vanLeer01;

    div(phi,alphaRho)   Gauss vanLeer;   // Gauss limitedLinear 1
    div(phiR,alphaRho)  Gauss vanLeer;

}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         corrected;
}

fluxRequired
{
    default         no;
    p_rgh;
    "alphaRho.*";
}


