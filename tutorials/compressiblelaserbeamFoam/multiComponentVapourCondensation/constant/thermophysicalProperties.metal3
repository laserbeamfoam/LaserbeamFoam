FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.metal3;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseState      condensed;  // or: gaseous, solid

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState adiabaticPerfectFluid;
    specie          specie;
    energy          sensibleInternalEnergy;
}

// Zn: melting point 692.7 K, boiling point 1180 K
TSolidus	688;
TLiquidus	698;
LatentHeat	1.12e+05;        // latent heat of FUSION [J/kg]
elec_conductivity	2.8e6;
magnetic_permeability	1.256e-6;

mixture
{
    specie
    {
        molWeight   65.38;
    }
    equationOfState
    {
        p0	1e5;
        rho0         6570;
        gamma	1.2;
        B	1e7;          // soft liquid (c ~ 35-45 m/s) for tutorial timestep
    }
    thermodynamics
    {
        Cp          480;
        Hf          0;
    }
    transport
    {
        mu          0.0035;
        Pr          0.034;        // Pr = mu*Cp/k, k = 50 W/m/K
    }
}


// ************************************************************************* //
