FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.metal2vapour;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseState      gaseous;  // or: gaseous, solid

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          eConst;
    equationOfState perfectFluid;
    specie          specie;
    energy          sensibleInternalEnergy;
}

// Pb vapour (monatomic): R = Ru/W = 40.13 J/kg/K, Cv = 3/2 R
TSolidus	5.0;
TLiquidus	10.0;
LatentHeat	1.0;

elec_conductivity	1.0;
magnetic_permeability	1.256e-6;

mixture
{
    specie
    {
        molWeight   207.2;
    }
    equationOfState
    {
        rho0         0.0;        // ideal gas: rho = p/(R T)
        R	40.13;
    }
    thermodynamics
    {
        Cv          60.2;
        Hf          0;
    }
    transport
    {
        mu          1.0e-5;
        Pr          1.0;
    }
}


// ************************************************************************* //
