//   metal4 = Cd (bubble vapour)  Tb = 1040 K   Psat(750) ~ 1150  Pa

pMin            5000;

P0	1e5;
interface_thickness	1e-3;

// Hertz-Knudsen accommodation (evaporation/condensation) coefficient.
accommodationCoeff	0.1;


