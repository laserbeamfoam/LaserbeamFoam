FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.metal1;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseState      condensed;  // or: gaseous, solid

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState adiabaticPerfectFluid;//rhoConst;//perfectFluid;
    specie          specie;
    energy          sensibleInternalEnergy;
}

TSolidus	1878.0;
TLiquidus	1928.0;
LatentHeat	2.85e5;
elec_conductivity	5.0e5;
magnetic_permeability	1.256e-6;

mixture
{
    specie
    {
        molWeight   44.607;
    }
    equationOfState
    {
        p0	101000;
        rho0         3995;
        gamma	1.2;
        B	1e10;
    }
    thermodynamics
    {
        Cp          830;
        Hf          0;
    }
    transport
    {
        mu          3.196e-3;
        Pr          0.0794;
    }
}


