FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     compressibleLaserbeamFoam;

startFrom       startTime;

startTime       0;

stopAt          noWriteNow; // endTime;

endTime         0.007;

deltaT          1e-12;

writeControl    adjustableRunTime;

writeInterval   0.001;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    #includeFunc mag(U)
}

adjustTimeStep  yes;

maxCo           0.125;
maxAlphaCo      0.125;
maxDeltaT       2.5e-5;

// ************************************************************************* //
