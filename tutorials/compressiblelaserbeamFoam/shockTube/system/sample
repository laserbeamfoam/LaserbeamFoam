FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sample;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            sets;
libs            (sampling);
interpolationScheme cellPoint;
setFormat       csv;

fields          (T mag(U) p rho);

sets
{
    data
    {
        type    cellCentre;
        axis    x;
        start   (-5 0 0);
        end     (5 0 0);
    }
}


